# MyAgent (Common Lisp) DeepSeek 环境变量配置
# 推荐直接启动 ./start.bat (Windows) 或 ./start.sh (Linux/macOS)，
# 然后在控制台输入 /model 配置，会自动保存到 ~/.myagent/config
#
# 也可手动复制此文件为 .env，或写入 ~/.myagent/config：

DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ── 可选：路径与运行时覆盖（一般无需设置） ──────────────────
# MYAGENT_SBCL=            # SBCL 可执行文件路径（默认从 PATH 自动探测）
# MYAGENT_ROOT=            # 项目根目录（默认自动检测 run.lisp 所在目录）
# MYAGENT_MEMORY_DIR=      # 记忆目录（默认 <项目根>/memory）
# MYAGENT_CONFIG=          # 配置文件路径（默认 ~/.myagent/config，含 API Key，勿提交）
# MYAGENT_CURL=            # curl 可执行文件名（默认 Windows: curl.exe / 其它: curl）
